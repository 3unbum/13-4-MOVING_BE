# Server
PORT=3001
NODE_ENV=development

# Database
#
# 팀 공용 개발 DB는 Supabase(moving-dev, Seoul)입니다.
# 실제 값은 AWS 파라미터 스토어에서 받으세요 — 자세한 내용은 DEV-DATABASE.md 참고.
#
#   aws ssm get-parameter --name DATABASE_URL --with-decryption \
#     --query Parameter.Value --output text
#
#   앱 실행용(Transaction pooler, 6543) — 평소엔 이걸 씁니다. ?pgbouncer=true 필수
#     postgresql://postgres.<프로젝트ID>:<비밀번호>@aws-0-ap-northeast-2.pooler.supabase.com:6543/postgres?pgbouncer=true
#
#   마이그레이션용(Session pooler, 5432) — migrate 명령 쓸 때만 잠깐 갈아끼웁니다
#     postgresql://postgres.<프로젝트ID>:<비밀번호>@aws-0-ap-northeast-2.pooler.supabase.com:5432/postgres
#
#   ⚠️ Direct connection(db.<프로젝트ID>.supabase.co)은 IPv6 전용이라 대부분 연결이 안 됩니다.
#
# 로컬 PostgreSQL을 쓰려면: postgresql://user:password@localhost:5432/moving
DATABASE_URL=

# JWT
JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=14d

# AWS
AWS_PUBLIC_BUCKET_NAME=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=

# OAuth 신규가입 2단계 임시 토큰 (isNewUser일 때 발급, phoneNumber 입력 전까지 provider/role 등을 담아둠)
OAUTH_SIGNUP_TOKEN_SECRET=
OAUTH_SIGNUP_TOKEN_EXPIRES_IN=10m

# CORS
CLIENT_URL=http://localhost:3000

# OAuth - Google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# OAuth - Naver
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# OAuth - Kakao
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=

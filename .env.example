# Server
PORT=3001
NODE_ENV=development

# Database
#
# 팀 공용 개발 DB는 Supabase(moving-dev, Seoul)입니다.
# 실제 값은 AWS 파라미터 스토어에서 받으세요 — 자세한 내용은 DEV-DATABASE.md 참고.
#
#   aws ssm get-parameter --name DATABASE_URL --with-decryption \
#     --query Parameter.Value --output text
#
#   앱 실행용(Transaction pooler, 6543) — 평소엔 이걸 씁니다. ?pgbouncer=true 필수
#     postgresql://postgres.<프로젝트ID>:<비밀번호>@aws-0-ap-northeast-2.pooler.supabase.com:6543/postgres?pgbouncer=true
#
#   마이그레이션용(Session pooler, 5432) — migrate 명령 쓸 때만 잠깐 갈아끼웁니다
#     postgresql://postgres.<프로젝트ID>:<비밀번호>@aws-0-ap-northeast-2.pooler.supabase.com:5432/postgres
#
#   ⚠️ Direct connection(db.<프로젝트ID>.supabase.co)은 IPv6 전용이라 대부분 연결이 안 됩니다.
#
# 로컬 PostgreSQL을 쓰려면: postgresql://user:password@localhost:5432/moving
DATABASE_URL=

# JWT
JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=14d

# AWS
AWS_PUBLIC_BUCKET_NAME=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=

# OAuth 신규가입 2단계 임시 토큰 (isNewUser일 때 발급, phoneNumber 입력 전까지 provider/role 등을 담아둠)
OAUTH_SIGNUP_TOKEN_SECRET=
OAUTH_SIGNUP_TOKEN_EXPIRES_IN=10m

# CORS
CLIENT_URL=http://localhost:3000

# OAuth - Google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# OAuth - Naver
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# OAuth - Kakao
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=

# EC2 SSH 터널 (npm run tunnel / npm run ssh)
# 로컬에서 RDS에 붙을 때 씁니다. EC2를 거쳐 5433 → RDS 5432로 포워딩합니다.
#   npm run tunnel  터널만 (출력 없이 멈춰 있으면 정상, 터미널 유지)
#   npm run ssh     서버 접속
# pem 키는 chmod 400 필수. ~ 대신 절대 경로로 적어야 합니다.
SSH_KEY_PATH=/Users/{사용자명}/.ssh/{키파일}.pem
EC2_HOST=
EC2_USER=ec2-user
DB_HOST=

# 터널을 쓸 때 DATABASE_URL은 localhost:5433을 가리킵니다.
# RDS 인증서는 호스트명이 실제 엔드포인트라 터널(localhost)에서는 verify-full이 안 됩니다.
# SSH 터널 자체가 암호화되므로 로컬에서는 no-verify를 씁니다(운영 EC2는 verify-full).
#   DATABASE_URL="postgresql://{유저}:{비번}@localhost:5433/moving?sslmode=no-verify"

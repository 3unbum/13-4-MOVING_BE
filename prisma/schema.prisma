// 무빙 Prisma 스키마
// ERD 원본: docs/스키마/message.txt (DBML)
//
// 규칙
//   - DB 컬럼/테이블은 snake_case, 코드에서는 camelCase (@map / @@map)
//   - 8/31 회의 반영: user.refreshToken, moverProfile.reviewCount/confirmedCount

generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

// ───────────────────────────── Enum ─────────────────────────────

enum UserRole {
  CUSTOMER
  MOVER

  @@map("user_role")
}

enum SocialProvider {
  GOOGLE
  NAVER
  KAKAO
  LOCAL

  @@map("social_provider")
}

enum ServiceType {
  SMALL  @map("소형이사")
  HOME   @map("가정이사")
  OFFICE @map("사무실이사")

  @@map("service_type")
}

enum RegionType {
  SEOUL     @map("서울")
  GYEONGGI  @map("경기")
  INCHEON   @map("인천")
  GANGWON   @map("강원")
  CHUNGBUK  @map("충북")
  CHUNGNAM  @map("충남")
  SEJONG    @map("세종")
  DAEJEON   @map("대전")
  JEONBUK   @map("전북")
  JEONNAM   @map("전남")
  GWANGJU   @map("광주")
  GYEONGBUK @map("경북")
  GYEONGNAM @map("경남")
  DAEGU     @map("대구")
  ULSAN     @map("울산")
  BUSAN     @map("부산")
  JEJU      @map("제주")

  @@map("region_type")
}

/// PENDING·ASSIGNED = 활성 요청. 유저당 활성 1건만 허용(앱 레벨 검증)
enum QuotationStatus {
  PENDING /// 견적 대기 (활성)
  ASSIGNED /// 기사님 확정, 이사 전 (활성)
  COMPLETED /// 이사일 경과
  EXPIRED /// 견적 없이 이사일 경과

  @@map("quotation_status")
}

enum EstimateStatus {
  PENDING
  CONFIRMED
  REJECTED
  COMPLETED

  @@map("estimate_status")
}

/// 기사님이 이사 완료 후 요청하는 추가 금액 한 건의 상태.
/// PROPOSED(고객 응답 대기) → APPROVED(잔금에 합산) | REJECTED(잔금은 기존 금액 그대로)
enum ExtraChargeStatus {
  PROPOSED
  APPROVED
  REJECTED

  @@map("extra_charge_status")
}

/// 이사가 끝난(COMPLETED) 견적의 결제 여부. 결제 대상은 COMPLETED 견적뿐이라
/// 다른 상태에서는 항상 UNPAID입니다.
enum PaymentStatus {
  UNPAID
  PAID

  @@map("payment_status")
}

enum ReviewStatus {
  PENDING
  CONFIRMED

  @@map("review_status")
}

/// 알림 종류. notification.service.ts의 NotificationType과 값을 맞춥니다.
enum NotificationType {
  NEW_REQUEST /// 견적 요청 생성·지정 요청 → 해당 지역 기사님
  NEW_ESTIMATE /// 기사님이 견적 발송 → 요청한 유저
  ESTIMATE_CONFIRMED /// 유저가 견적 확정 → 기사님 + 고객
  ESTIMATE_REJECTED /// 기사님이 지정 견적을 반려 → 요청한 고객
  MOVING_DAY_BEFORE /// 이사 전날 09:00 배치 → 고객 + 확정 기사님
  MOVING_DAY /// 이사 당일 09:00 배치 → 고객 + 확정 기사님
  NEW_CHAT_MESSAGE /// 채팅 메시지 도착 → 상대방. 방당 1건으로 합쳐 새 메시지가 오면 다시 읽지 않음으로 올립니다
  PAYMENT_REQUEST /// 기사님이 이사 완료 견적의 결제를 요청 → 고객. 견적당 1번만
  PAYMENT_COMPLETED /// 고객이 견적을 결제 → 그 견적을 보낸 기사님
  DEPOSIT_PAID /// 고객이 선수금을 결제 → 그 견적을 보낸 기사님 (이사 확정)
  DEPOSIT_EXPIRED /// 선수금 기한 만료로 확정이 자동 취소 → 고객 + 기사님
  EXTRA_CHARGE_PROPOSED /// 기사님이 추가 금액을 요청 → 고객
  EXTRA_CHARGE_RESPONDED /// 고객이 추가 금액을 승인·거절 → 그 견적을 보낸 기사님

  @@map("notification_type")
}

// ───────────────────────────── 유저 ─────────────────────────────

/// 한 사람이 다른 역할로 가입하는 것을 허용합니다.
///
/// 이메일 중복 방지는 두 갈래로 나뉩니다.
///   - 소셜: (role, provider, providerId) 유니크로 방지
///   - 이메일 가입(LOCAL): 부분 유니크 인덱스로 방지
///     → migration.sql의 user_role_email_local_key 참조
/// (role, email) 전체 유니크를 걸면 같은 이메일의 소셜 계정끼리도 막히므로 사용하지 않습니다.
model User {
  id           Int             @id @default(autoincrement())
  role         UserRole
  name         String
  email        String
  phoneNumber  String          @map("phone_number")
  /// 소셜 로그인 유저는 NULL
  password     String?
  /// 이메일 가입이면 LOCAL
  provider     SocialProvider?
  /// LOCAL이면 NULL
  providerId   String?         @map("provider_id")
  /// 8/31 회의 결정 — 로그아웃/재발급 시 무효화
  refreshToken String?         @map("refresh_token")
  /// 탈퇴 시각. 탈퇴해도 리뷰·완료된 견적이 Cascade로 지워지지 않도록 행은 남기고 개인정보만 지웁니다
  deletedAt    DateTime?       @map("deleted_at")
  createdAt    DateTime        @default(now()) @map("created_at")
  updatedAt    DateTime        @updatedAt @map("updated_at")

  customerProfile             CustomerProfile?
  moverProfile                MoverProfile?
  customerServices            CustomerService[]
  moverServices               MoverService[]
  moverRegions                MoverRegion[]
  quotationRequests           QuotationRequest[]
  targetedRequests            TargetedRequest[]
  estimates                   Estimate[]
  reviews                     Review[]
  favorites                   Favorite[]    @relation("FavoriteCustomer")
  favoritedBy                 Favorite[]    @relation("FavoriteMover")
  notifications               Notification[]
  passwordResetCode           PasswordResetCode?
  profileEditVerificationCode ProfileEditVerificationCode?
  chatRoomsAsCustomer         ChatRoom[]    @relation("ChatRoomCustomer")
  chatRoomsAsMover            ChatRoom[]    @relation("ChatRoomMover")
  chatMessages                ChatMessage[] @relation("ChatMessageSender")
  moverAiSessions             MoverAiSession[]

  @@unique([role, provider, providerId])
  /// 로그인 조회용 — 유니크를 뺐으므로 인덱스는 별도로 유지합니다
  @@index([role, email])
  @@map("user")
}

/// 비밀번호 재설정 인증번호 — 유저당 한 행만 유지합니다.
/// 재발송 시 upsert가 아니라 삭제 후 생성해야 id가 바뀌어 이전 재설정 토큰(codeId)이 무효화됩니다.
model PasswordResetCode {
  id             Int       @id @default(autoincrement())
  userId         Int       @unique @map("user_id")
  /// 인증번호 평문은 저장하지 않습니다
  codeHash       String    @map("code_hash")
  expiresAt      DateTime  @map("expires_at")
  /// 틀린 입력 횟수 — 상한 도달 시 이 코드는 무효
  failedAttempts Int       @default(0) @map("failed_attempts")
  /// 재설정 완료 시각 — 값이 있으면 재설정 토큰 재사용 거부
  usedAt         DateTime? @map("used_at")
  createdAt      DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("password_reset_code")
}

/// 프로필 수정 진입용 이메일 인증번호 — 유저당 한 행만 유지합니다.
/// 비밀번호 재설정 인증번호(PasswordResetCode)와 용도가 분리되어 있어 테이블도 분리합니다.
/// 재발송 시 upsert가 아니라 삭제 후 생성해야 id가 바뀌어 이전 인증을 무효화합니다.
model ProfileEditVerificationCode {
  id             Int       @id @default(autoincrement())
  userId         Int       @unique @map("user_id")
  /// 인증번호 평문은 저장하지 않습니다
  codeHash       String    @map("code_hash")
  expiresAt      DateTime  @map("expires_at")
  /// 틀린 입력 횟수 — 상한 도달 시 이 코드는 무효
  failedAttempts Int       @default(0) @map("failed_attempts")
  /// 인증 완료 시각 — 값이 있으면 재사용 거부
  usedAt         DateTime? @map("used_at")
  createdAt      DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("profile_edit_verification_code")
}

/// 이메일 회원가입 인증번호 — (email, role)당 한 행만 유지합니다.
/// 가입 전이라 User와 관계가 없습니다. 인증에 성공하면 verifiedAt을 기록하고, 가입이 끝나면 행을 지웁니다.
/// 가입하지 않고 남은 행은 따로 정리하지 않습니다(다시 요청하면 지우고 새로 만듭니다).
model SignupEmailVerificationCode {
  id             Int       @id @default(autoincrement())
  email          String
  role           UserRole
  /// 인증번호 평문은 저장하지 않습니다
  codeHash       String    @map("code_hash")
  expiresAt      DateTime  @map("expires_at")
  /// 틀린 입력 횟수 — 상한 도달 시 이 코드는 무효
  failedAttempts Int       @default(0) @map("failed_attempts")
  /// 인증 성공 시각 — 이후 일정 시간 안에만 가입할 수 있습니다
  verifiedAt     DateTime? @map("verified_at")
  createdAt      DateTime  @default(now()) @map("created_at")

  @@unique([email, role])
  @@map("signup_email_verification_code")
}

/// row 존재 여부가 곧 "프로필 등록 완료" 여부입니다.
/// 등록 전에는 전용 기능 접근 불가 — 앱에서 강제합니다.
model CustomerProfile {
  id        Int         @id @default(autoincrement())
  userId    Int         @unique @map("user_id")
  image     String?
  /// "내가 사는 지역" — 단일 선택, 언제든 수정 가능
  region    RegionType?
  createdAt DateTime    @default(now()) @map("created_at")
  updatedAt DateTime    @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("customer_profile")
}

model MoverProfile {
  id             Int      @id @default(autoincrement())
  userId         Int      @unique @map("user_id")
  /// 기사님도 사진만 optional, 나머지 전부 필수
  image          String?
  nickName       String   @map("nick_name")
  career         Int
  /// 한 줄 소개
  bio            String
  /// 상세 설명
  description    String
  /// 비정규화 — 평점 정렬용. review 작성/수정 시 갱신
  avgRating      Decimal  @default(0) @map("avg_rating") @db.Decimal(2, 1)
  /// 8/31 회의 결정 — 리뷰 작성(CONFIRMED) 시 갱신
  reviewCount    Int      @default(0) @map("review_count")
  /// 8/31 회의 결정 — 견적 확정 시 갱신
  confirmedCount Int      @default(0) @map("confirmed_count")
  /// 반정규화 — 찜 추가/해제 시 갱신 (API 명세 #21·#22)
  favoriteCount  Int      @default(0) @map("favorite_count")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// 무한 스크롤 커서 페이지네이션용 정렬 인덱스 (API 명세 #21)
  /// id를 함께 넣어 정렬 키가 같을 때 순서가 흔들리지 않게 합니다
  @@index([avgRating, id])
  @@index([reviewCount, id])
  @@index([career, id])
  @@index([confirmedCount, id])
  @@map("mover_profile")
}

/// 일반 유저의 "이용 서비스" (중복 선택 가능)
model CustomerService {
  userId  Int         @map("user_id")
  service ServiceType

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, service])
  @@map("customer_service")
}

/// 기사님의 "제공 서비스" (필수, 1개 이상 — 앱 레벨 검증)
model MoverService {
  moverId Int         @map("mover_id")
  service ServiceType

  mover User @relation(fields: [moverId], references: [id], onDelete: Cascade)

  @@id([moverId, service])
  /// 역방향 조회 — "이 서비스 가능한 기사님 목록"
  /// PK는 기사님→서비스 방향만 커버해 매칭 쿼리가 인덱스를 타지 못합니다.
  /// 사용처: 기사님 찾기 유형 필터(#21), 견적 요청 매칭(#15)
  @@index([service, moverId])
  @@map("mover_service")
}

/// 기사님의 "서비스 가능 지역" (필수, 1개 이상 — 앱 레벨 검증)
model MoverRegion {
  moverId Int        @map("mover_id")
  region  RegionType

  mover User @relation(fields: [moverId], references: [id], onDelete: Cascade)

  @@id([moverId, region])
  /// 역방향 조회 — "이 지역 가능한 기사님 목록"
  /// 사용처: 기사님 찾기 지역 필터(#21), 견적 요청 시 NEW_REQUEST 알림 대상 조회(#15)
  @@index([region, moverId])
  @@map("mover_region")
}

// ───────────────────────────── 견적 ─────────────────────────────

/// 활성 요청 = quotationStatus IN (PENDING, ASSIGNED).
/// 유저당 1건만 허용 — MVP는 앱 레벨 검증, 이후 부분 유니크 인덱스로 승격.
model QuotationRequest {
  id                Int             @id @default(autoincrement())
  /// 요청한 소비자 (role=CUSTOMER)
  userId            Int             @map("user_id")
  /// 이사 종류
  category          ServiceType
  /// 이사 예정일
  movingDate        DateTime        @map("moving_date") @db.Date
  fromPostalCode    String          @map("from_postal_code")
  /// 출발지 시도 — 우편번호 응답에서 확정. 기사님 매칭용
  fromRegion        RegionType      @map("from_region")
  fromAddress       String          @map("from_address")
  fromDetailAddress String          @map("from_detail_address")
  toPostalCode      String          @map("to_postal_code")
  /// 도착지 시도 — 우편번호 응답에서 확정
  toRegion          RegionType      @map("to_region")
  toAddress         String          @map("to_address")
  toDetailAddress   String          @map("to_detail_address")
  quotationStatus   QuotationStatus @map("quotation_status")
  createdAt         DateTime        @default(now()) @map("created_at")
  updatedAt         DateTime        @updatedAt @map("updated_at")

  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  targetedRequests TargetedRequest[]
  estimates        Estimate[]
  notifications    Notification[]

  @@index([fromRegion, quotationStatus])
  @@index([userId, quotationStatus])
  @@index([movingDate, quotationStatus])
  @@map("quotation_request")
}

/// 지정 견적 요청 — 요청 1건당 최대 3 row (앱 레벨 검증).
/// row 존재 여부로 일반/지정을 구분합니다.
/// 지정했으나 기사님이 아직 견적 미발송인 상태도 표현할 수 있습니다.
model TargetedRequest {
  id                 Int      @id @default(autoincrement())
  quotationRequestId Int      @map("quotation_request_id")
  /// 지정된 기사님 (role=MOVER)
  moverId            Int      @map("mover_id")
  createdAt          DateTime @default(now()) @map("created_at")

  quotationRequest QuotationRequest @relation(fields: [quotationRequestId], references: [id], onDelete: Cascade)
  mover            User             @relation(fields: [moverId], references: [id], onDelete: Cascade)

  @@unique([quotationRequestId, moverId])
  @@index([moverId])
  @@map("targeted_request")
}

/// 한 요청에 기사님 1명당 견적 1건.
/// 상한 8건(일반 5 + 지정 3) 계산의 전제입니다.
model Estimate {
  id                 Int                @id @default(autoincrement())
  quotationRequestId Int                @map("quotation_request_id")
  /// 견적을 보낸(혹은 반려한) 기사님 (role=MOVER)
  moverId            Int                @map("mover_id")
  /// REJECTED면 NULL
  price              Int?
  /// 견적 요청 보낼 때 요청 반려 모두 필숫값
  comment            String
  estimateStatus     EstimateStatus     @default(PENDING) @map("estimate_status")
  /// 결제 여부. POST /estimates/:id/pay가 COMPLETED + UNPAID일 때만 PAID로 바꿉니다
  paymentStatus      PaymentStatus      @default(UNPAID) @map("payment_status")
  /// 결제 완료 시각. UNPAID면 NULL
  paidAt             DateTime?          @map("paid_at")
  /// 토스페이먼츠 결제 키. 같은 결제를 다른 견적에 재사용하지 못하도록 유니크. UNPAID면 NULL
  paymentKey         String?            @unique @map("payment_key")
  /// 기사님이 결제 요청 알림을 보낸 시각. 견적당 1번만 보낼 수 있어 NULL일 때만 요청할 수 있습니다
  paymentRequestedAt DateTime?          @map("payment_requested_at")
  /// 선수금(견적의 10%, 10원 단위 내림). 확정 시점에 정해 저장합니다. 확정 전·옛 데이터는 NULL
  depositAmount      Int?               @map("deposit_amount")
  /// 선수금 결제 기한 = min(확정 + 48시간, 이사일 0시 KST). 넘기면 확정이 자동 취소됩니다
  depositDueAt       DateTime?          @map("deposit_due_at")
  /// 선수금 결제 시각. NULL이면 미결제
  depositPaidAt      DateTime?          @map("deposit_paid_at")
  /// 선수금 토스 결제 키 (유니크 — 같은 결제를 다른 견적에 재사용하지 못하게)
  depositPaymentKey  String?            @unique @map("deposit_payment_key")
  createdAt          DateTime           @default(now()) @map("created_at")
  updatedAt          DateTime           @updatedAt @map("updated_at")

  quotationRequest QuotationRequest @relation(fields: [quotationRequestId], references: [id], onDelete: Cascade)
  mover            User             @relation(fields: [moverId], references: [id], onDelete: Cascade)
  review           Review?
  notifications    Notification[]
  chatRoom         ChatRoom?
  extraCharges     EstimateExtraCharge[]

  @@unique([quotationRequestId, moverId])
  @@index([moverId, estimateStatus])
  @@map("estimate")
}

/// 기사님이 이사 완료 후 요청하는 추가 금액 한 건. 견적당 여러 건을 보낼 수 있고,
/// 고객이 건별로 승인·거절합니다. 승인된 건의 합계가 잔금에 더해집니다.
/// 금액 상한(견적의 20%)은 거절되지 않은 건(PROPOSED + APPROVED)의 **합계**에 적용합니다.
model EstimateExtraCharge {
  id          Int               @id @default(autoincrement())
  estimateId  Int               @map("estimate_id")
  amount      Int
  /// 고객이 승인 여부를 판단하는 근거입니다
  reason      String
  status      ExtraChargeStatus @default(PROPOSED)
  createdAt   DateTime          @default(now()) @map("created_at")
  /// 승인·거절한 시각. PROPOSED면 NULL
  respondedAt DateTime?         @map("responded_at")

  estimate Estimate @relation(fields: [estimateId], references: [id], onDelete: Cascade)

  @@index([estimateId])
  @@map("estimate_extra_charge")
}

/// DB가 보장하지 못하므로 API에서 반드시 검증하세요.
///   1) customerId == estimate → quotationRequest.userId (본인 견적인지)
///   2) estimateStatus == COMPLETED (이사 완료 후인지)
model Review {
  id         Int          @id @default(autoincrement())
  estimateId Int          @unique @map("estimate_id")
  /// 작성한 소비자
  customerId Int          @map("customer_id")
  /// PENDING이면 NULL. 1~5
  rating     Int?
  /// PENDING이면 NULL
  comment    String?
  /// estimate가 COMPLETED가 되는 순간 PENDING으로 자동 생성, 작성하면 CONFIRMED
  status     ReviewStatus @default(PENDING) @map("review_status")
  createdAt  DateTime     @default(now()) @map("created_at")
  /// 확정 후 내용·사진을 고친 시각. 한 번도 수정하지 않으면 null
  editedAt   DateTime?    @map("edited_at")

  estimate Estimate     @relation(fields: [estimateId], references: [id], onDelete: Cascade)
  customer User         @relation(fields: [customerId], references: [id], onDelete: Cascade)
  /// 첨부 사진. 리뷰당 최대 3장은 DB가 보장하지 않으므로 API에서 막습니다.
  images   ReviewImage[]

  @@index([customerId, status])
  @@map("review")
}

/// 리뷰 첨부 사진. 파일은 S3에 두고 URL만 저장합니다.
/// 본인 리뷰가 PENDING·CONFIRMED일 때 추가·삭제할 수 있고, 리뷰당 최대 3장은 API에서 막습니다.
model ReviewImage {
  id        Int      @id @default(autoincrement())
  reviewId  Int      @map("review_id")
  imageUrl  String   @map("image_url")
  /// 같은 리뷰 안에서의 표시 순서. 작을수록 앞입니다.
  sortOrder Int      @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")

  review Review @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  @@index([reviewId, sortOrder])
  @@map("review_image")
}

model Favorite {
  id        Int      @id @default(autoincrement())
  /// 찜한 소비자
  userId    Int      @map("user_id")
  /// 찜 대상 기사님
  moverId   Int      @map("mover_id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user  User @relation("FavoriteCustomer", fields: [userId], references: [id], onDelete: Cascade)
  mover User @relation("FavoriteMover", fields: [moverId], references: [id], onDelete: Cascade)

  @@unique([userId, moverId])
  @@index([moverId])
  @@map("favorite")
}

/// 값은 NotificationType enum과 맞춥니다.
/// 이사 전날·당일 중복은 마이그레이션의 partial unique로만 막습니다
/// (user_id, quotation_request_id, type WHERE type IN ('MOVING_DAY','MOVING_DAY_BEFORE')).
/// NEW_REQUEST는 지역 알림 후 지정 요청이 한 번 더 갈 수 있어 같은 유니크를 걸지 않습니다.
/// 채팅 알림은 (user_id, chat_room_id) partial unique(WHERE chat_room_id IS NOT NULL)로
/// 받는 사람 × 방당 1건만 둡니다 — 메시지마다 행을 만들지 않고 같은 행을 갱신합니다.
model Notification {
  id                 Int              @id @default(autoincrement())
  /// 수신자. 소비자·기사님 양쪽 모두 수신하므로 userId입니다
  userId             Int              @map("user_id")
  /// "새 견적 / 견적 확정" 알림일 때만
  estimateId         Int?             @map("estimate_id")
  /// "새 요청 / 이사 전날·당일" 알림일 때만
  quotationRequestId Int?             @map("quotation_request_id")
  /// "새 채팅 메시지" 알림일 때만
  chatRoomId         Int?             @map("chat_room_id")
  type               NotificationType
  message            String?
  isRead             Boolean          @default(false) @map("is_read")
  createdAt          DateTime         @default(now()) @map("created_at")

  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  estimate         Estimate?         @relation(fields: [estimateId], references: [id], onDelete: Cascade)
  quotationRequest QuotationRequest? @relation(fields: [quotationRequestId], references: [id], onDelete: Cascade)
  chatRoom         ChatRoom?         @relation(fields: [chatRoomId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@map("notification")
}

/// 확정된 견적당 1:1 채팅방. 고객·기사님만 참여합니다.
model ChatRoom {
  id                 Int      @id @default(autoincrement())
  estimateId         Int      @unique @map("estimate_id")
  customerId         Int      @map("customer_id")
  /// estimate.moverId 복사
  moverId            Int      @map("mover_id")
  lastMessageAt      DateTime @default(now()) @map("last_message_at")
  /// FK 없음 (ChatMessage와 순환 방지). 커지는 방향으로만 갱신
  customerLastReadId Int?     @map("customer_last_read_id")
  moverLastReadId    Int?     @map("mover_last_read_id")
  createdAt          DateTime @default(now()) @map("created_at")

  estimate      Estimate       @relation(fields: [estimateId], references: [id], onDelete: Cascade)
  customer      User           @relation("ChatRoomCustomer", fields: [customerId], references: [id], onDelete: Cascade)
  mover         User           @relation("ChatRoomMover", fields: [moverId], references: [id], onDelete: Cascade)
  messages      ChatMessage[]
  notifications Notification[]

  @@index([customerId, lastMessageAt])
  @@index([moverId, lastMessageAt])
  @@map("chat_room")
}

model ChatMessage {
  id        Int      @id @default(autoincrement())
  roomId    Int      @map("room_id")
  senderId  Int      @map("sender_id")
  /// 사진만 보낸 메시지는 빈 문자열
  content   String
  /// 사진 메시지일 때만. 한 메시지에 한 장
  imageUrl  String?  @map("image_url")
  createdAt DateTime @default(now()) @map("created_at")

  room   ChatRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  sender User     @relation("ChatMessageSender", fields: [senderId], references: [id], onDelete: Cascade)

  @@index([roomId, id])
  @@map("chat_message")
}

/// 기사님 AI 찾기 대화 세션. CUSTOMER 로그인 유저만 생성합니다.
model MoverAiSession {
  id        String       @id @default(cuid())
  userId    Int          @map("user_id")
  /// 현재까지 확정된 검색 슬롯
  region    RegionType?
  service   ServiceType?
  sort      String?
  /// SHOW_MORE용 커서
  cursor    String?
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")

  user     User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages MoverAiMessage[]

  @@index([userId, updatedAt])
  @@map("mover_ai_session")
}

model MoverAiMessage {
  id        String   @id @default(cuid())
  sessionId String   @map("session_id")
  /// USER | ASSISTANT | SYSTEM
  role      String
  content   String
  /// ASSISTANT일 때 filters/nextAction/moverIds 등 스냅샷
  payload   Json?
  createdAt DateTime @default(now()) @map("created_at")

  session MoverAiSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, createdAt])
  @@map("mover_ai_message")
}
